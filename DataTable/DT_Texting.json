    "Rows": {
      "0": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_01",
          "SourceString": "X：可恶！",
          "LocalizedString": "X: So close!"
        },
        "IntervalTime": 1.0,
        "Rate": 0.075
      },
      "1": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_02",
          "SourceString": "Y：\\(>▽<)/",
          "LocalizedString": "Y: \\(>▽<)/"
        },
        "IntervalTime": 1.0,
        "Rate": 0.02
      },
      "2": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_03",
          "SourceString": "X：明明我没有失误啊？专门练了那套",
          "LocalizedString": "X: I totally nailed that special combo"
        },
        "IntervalTime": 2.0,
        "Rate": 0.075
      },
      "3": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_04",
          "SourceString": "X：结果就差那么一点还是赢不了你！",
          "LocalizedString": "X: and still I couldn't win!"
        },
        "IntervalTime": 2.0,
        "Rate": 0.075
      },
      "4": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_05",
          "SourceString": "Y：X，也该考虑换个英雄了",
          "LocalizedString": "Y: Time to try a different character, X"
        },
        "IntervalTime": 0.1,
        "Rate": 0.075
      },
      "5": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_06",
          "SourceString": "X：Y，你确定你没耍赖吧？",
          "LocalizedString": "X: You sure you weren't cheating?"
        },
        "IntervalTime": 2.0,
        "Rate": 0.075
      },
      "6": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_07",
          "SourceString": "Y：才没啊！！",
          "LocalizedString": "Y: No way!"
        },
        "IntervalTime": 0.6,
        "Rate": 0.075
      },
      "7": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_08",
          "SourceString": "Y：当然只要我想，我在这台电脑里就是无敌的哦？",
          "LocalizedString": "Y: Of course I can be invincible on this computer anytime I want."
        },
        "IntervalTime": 1.8,
        "Rate": 0.06
      },
      "8": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_09",
          "SourceString": "Y：但这次没有啦，和你打对抗的话我不想开挂",
          "LocalizedString": "Y: But not this time. I value every match against you so I play fair."
        },
        "IntervalTime": 2.0,
        "Rate": 0.06
      },
      "9": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_10",
          "SourceString": "X：emmmm",
          "LocalizedString": "X: Hmmmm"
        },
        "IntervalTime": 2.5,
        "Rate": 0.3
      },
      "10": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_11",
          "SourceString": "X：那还是我掌握得不够？",
          "LocalizedString": "X: I guess I need more practice then."
        },
        "IntervalTime": 1.7,
        "Rate": 0.075
      },
      "11": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_12",
          "SourceString": "Y：别灰心嘛~其实已经很厉害啦！",
          "LocalizedString": "Y: Keep your head up, you're doing great already!"
        },
        "IntervalTime": 1.6,
        "Rate": 0.075
      },
      "12": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_13",
          "SourceString": "Y：(☆ω☆)",
          "LocalizedString": "Y: (☆ω☆)"
        },
        "IntervalTime": 1.5,
        "Rate": 0.02
      },
      "13": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_14",
          "SourceString": "Y：我估摸也有角色相性的原因",
          "LocalizedString": "Y: I think the matchup might be part of it too"
        },
        "IntervalTime": 1.5,
        "Rate": 0.06
      },
      "14": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_15",
          "SourceString": "Y：要不要改变下选择看看？",
          "LocalizedString": "Y: Why not try some other characters?"
        },
        "IntervalTime": 1.5,
        "Rate": 0.06
      },
      "15": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_16",
          "SourceString": "Y：有点下次结果就说不准了的感觉",
          "LocalizedString": "Y: I have a feeling that things might turn out differently next time"
        },
        "IntervalTime": 3.0,
        "Rate": 0.075
      },
      "16": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_17",
          "SourceString": "X：等等",
          "LocalizedString": "X: Wait"
        },
        "IntervalTime": 0.5,
        "Rate": 0.06
      },
      "17": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_18",
          "SourceString": "X：哈哈",
          "LocalizedString": "X: Hahah"
        },
        "IntervalTime": 0.4,
        "Rate": 0.04
      },
      "18": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_19",
          "SourceString": "Y：哦？什么什么？",
          "LocalizedString": "Y: Oh, what is it?"
        },
        "IntervalTime": 1.5,
        "Rate": 0.04
      },
      "19": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_20",
          "SourceString": "X：我有点子了Y！",
          "LocalizedString": "X: I got it, Y!"
        },
        "IntervalTime": 1.2,
        "Rate": 0.05
      },
      "20": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_21",
          "SourceString": "X：下次会有新的破解之法",
          "LocalizedString": "X: I'll find a way to beat you in our next game"
        },
        "IntervalTime": 1.1,
        "Rate": 0.05
      },
      "21": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_22",
          "SourceString": "Y：不愧是X！",
          "LocalizedString": "Y: That's the spirit, X!"
        },
        "IntervalTime": 0.8,
        "Rate": 0.075
      },
      "22": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_23",
          "SourceString": "Y：(*ˊ▽ˋ*)",
          "LocalizedString": "Y: (*ˊ▽ˋ*)"
        },
        "IntervalTime": 1.0,
        "Rate": 0.02
      },
      "23": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_24",
          "SourceString": "X：跟你说好咯！",
          "LocalizedString": "X: Then it's a deal!"
        },
        "IntervalTime": 1.0,
        "Rate": 0.075
      },
      "24": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_25",
          "SourceString": "X：等着吧！",
          "LocalizedString": "X: Wait and see!"
        },
        "IntervalTime": 0.8,
        "Rate": 0.075
      },
      "25": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_26",
          "SourceString": "Y：好好我等着w",
          "LocalizedString": "Y: Sure sure, not going anywhere"
        },
        "IntervalTime": 1.0,
        "Rate": 0.06
      },
      "26": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_27",
          "SourceString": "Y：那今天还玩别的不？",
          "LocalizedString": "Y: Any other games you wanna play today?"
        },
        "IntervalTime": 2.5,
        "Rate": 0.06
      },
      "27": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_28",
          "SourceString": "Y：啊已经很晚了，你要回去了吧？",
          "LocalizedString": "Y: Hmm, it's late. I guess you should head back now?"
        },
        "IntervalTime": 2.0,
        "Rate": 0.06
      },
      "28": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_29",
          "SourceString": "X：今天玩得眼睛都酸了",
          "LocalizedString": "X: My eyes feel so sore"
        },
        "IntervalTime": 1.5,
        "Rate": 0.075
      },
      "29": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_30",
          "SourceString": "X：下了下了",
          "LocalizedString": "X: Gotta go"
        },
        "IntervalTime": 1.0,
        "Rate": 0.075
      },
      "30": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_31",
          "SourceString": "X：明天再玩吧，Y！",
          "LocalizedString": "X: Let's play tomorrow, Y!"
        },
        "IntervalTime": 1.3,
        "Rate": 0.075
      },
      "31": {
        "Text": {
          "TableId": "/Game/Text/Dialogue/ST_Main_Exe01.ST_Main_Exe01",
          "Key": "Exe01_TypeText_32",
          "SourceString": "Y：嗯拜拜",
          "LocalizedString": "Y: Mhm, bye bye"
