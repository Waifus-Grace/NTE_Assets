        "BossName": {
          "TableId": "/Game/Text/ST_ActorName.ST_ActorName",
          "Key": "boss_13_Name",
          "SourceString": "无首铁驭",
          "LocalizedString": "Headless Rider"
        },
        "ContentDes": {
          "TableId": "/Game/Text/ST_Ui.ST_Ui",
          "Key": "DT_MonsterDropBox_MotoBKGdes",
          "SourceString": "只有深夜才会出现，骑着一台黑色摩托机车游荡于都市街头的无头骑士。据说会盯上时速超高的飙车族，与其进行竞速比赛并在胜利后用可怖的镰刀收割他们的暴走之魂。\r\n「刺骨的蓝火会燃尽一切热血。」",
          "LocalizedString": "A headless rider that appears only in the dead of night, roaming the city streets on a black motorcycle. Legend says it targets high-speed street racers, challenging them to races and harvesting their reckless psyches with a terrifying scythe after victory.\r\n\"Bone-chilling blue flames will burn away all passion.\""
        },
