        "BossName": {
          "TableId": "/Game/Text/ST_ActorName.ST_ActorName",
          "Key": "boss_07_Name",
          "SourceString": "塞润尼缇",
          "LocalizedString": "Serenetti"
        },
        "ContentDes": {
          "TableId": "/Game/Text/ST_Ui.ST_Ui",
          "Key": "UI_MonsterDropBoxMapDetails_FlowerBGKDes",
          "SourceString": "封闭内心的失声少年误入了被言语的恶意侵染的花房，花藤扎根与少年的血肉，汲取着养料，结成花茧。由此从未说出口的言语，尽数化为万物之形。\r\n「叱骂反调，为寂然无声，一言之庭。」",
          "LocalizedString": "A silent boy, who had shut his heart, wandered into a greenhouse poisoned by the malice of words. Vines took root in his flesh and blood, drawing sustenance and weaving cocoons of flowers. From this, his unspoken words transformed into the shapes of all things.\r\n\"Scolding and discord become silent stillness, a garden of words.\""
        },
