        "MailTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_CharacterBirthday_Hasuoer_Title_2026",
          "SourceString": "骑行邀约",
