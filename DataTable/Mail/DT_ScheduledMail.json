      "Lingke_2027": {
        "ScheduledTime": {
          "Year": 2027,
          "Month": 2,
          "Day": 14,
          "Hour": 0,
          "minute": 0,
          "Second": 0
        },
        "bDaySettle": true,
        "LatestValidTime": 60,
        "MailType": "EHTMailType::MT_PLAYER",
        "MailSubType": "EHTMailSubType::MT_Sub_Mail_Star",
        "MailTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_CharacterBirthday_Lingke_Title_2026",
          "SourceString": "想一起过生日！",
          "LocalizedString": "想一起过生日！"
        },
        "MailSubTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_CharacterBirthday_Lingke_Title_2026",
          "SourceString": "想一起过生日！",
          "LocalizedString": "想一起过生日！"
        },
        "MailContent": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_CharacterBirthday_Lingke_Content_2026",
          "SourceString": "鉴定师鉴定师，可能会有点突然，但今天是我生日!\r\n过去每年的这个日子，我都会带着生日蛋糕带到上晴塔顶，天上有几颗一等星，我就点几根蜡烛，然后等呀等，如果有彗星经过的话，就赶紧深呼吸许一个愿望——然后，它就会带着我的电波，去银河里转一圈！这样，全宇宙的星星就都收到我的邀请了!\r\n加入六队之后，我也邀请过大家和小贞一起去开宇宙生日派对，但他们好像更喜欢在办公室里开，不过无论是在哪里，我都很开心，因为生日就是要开心地过~\r\n鉴定师今天有空的话，可以和我一起玩吗？一起去沙滩？或者去港区转转……噢！我们去噗卡乐园吧！我一直想和鉴定师一起、噗卡乐园把所有地方都玩一遍！可以吗？",
          "LocalizedString": "鉴定师鉴定师，可能会有点突然，但今天是我生日!\r\n过去每年的这个日子，我都会带着生日蛋糕带到上晴塔顶，天上有几颗一等星，我就点几根蜡烛，然后等呀等，如果有彗星经过的话，就赶紧深呼吸许一个愿望——然后，它就会带着我的电波，去银河里转一圈！这样，全宇宙的星星就都收到我的邀请了!\r\n加入六队之后，我也邀请过大家和小贞一起去开宇宙生日派对，但他们好像更喜欢在办公室里开，不过无论是在哪里，我都很开心，因为生日就是要开心地过~\r\n鉴定师今天有空的话，可以和我一起玩吗？一起去沙滩？或者去港区转转……噢！我们去噗卡乐园吧！我一直想和鉴定师一起、噗卡乐园把所有地方都玩一遍！可以吗？"
        },
