        },
        "bDaySettle": true,
        "LatestValidTime": 60,
        "MailType": "EHTMailType::MT_PLAYER",
        "MailSubType": "EHTMailSubType::MT_Sub_Mail_Star",
        "MailTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_CharacterBirthday_Zaowu_Title_2026",
          "SourceString": "不准迟到！",
          "LocalizedString": "不准迟到！"
        },
        "MailSubTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_CharacterBirthday_Zaowu_Title_2026",
          "SourceString": "不准迟到！",
          "LocalizedString": "不准迟到！"
        },
        "MailContent": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_CharacterBirthday_Zaowu_Content_2026",
          "SourceString": "真想知道，你们怎么一个个都能把生日记得这么清楚？之前娜娜莉还追着我问，我哪有这种……哪记得这种小孩才盼着过的日子，谁知道她又找阿德勒问，还真给她问出了个日子……肯定是阿德勒随口说来糊弄娜娜莉的，给她记住真的当我的生日了，结果每年这时候她都要折腾个好久，也不知道今年会准备些什么……\r\n我可没在期待，只是不想扫她们的兴罢了！反正不管怎么样都是老一套吧，一个好大好大的蛋糕还有一堆不知道从哪翻出的小东西……总之，你今晚可不准迟到，迟到的话，就等着吃鬼郎丸啃剩的蛋糕吧！",
          "LocalizedString": "真想知道，你们怎么一个个都能把生日记得这么清楚？之前娜娜莉还追着我问，我哪有这种……哪记得这种小孩才盼着过的日子，谁知道她又找阿德勒问，还真给她问出了个日子……肯定是阿德勒随口说来糊弄娜娜莉的，给她记住真的当我的生日了，结果每年这时候她都要折腾个好久，也不知道今年会准备些什么……\r\n我可没在期待，只是不想扫她们的兴罢了！反正不管怎么样都是老一套吧，一个好大好大的蛋糕还有一堆不知道从哪翻出的小东西……总之，你今晚可不准迟到，迟到的话，就等着吃鬼郎丸啃剩的蛋糕吧！"
        },
