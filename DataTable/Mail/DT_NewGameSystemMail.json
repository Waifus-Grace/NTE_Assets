      "BagelCoinMail": {
        "MailUniqueID": "BagelCoinMail",
        "MailType": "EHTMailType::MT_Default",
        "MailSubType": "EHTMailSubType::MT_Sub_Default",
        "MailTitle": {
          "TableId": "/Game/Text/ST_Ui.ST_Ui",
          "Key": "BagelCoinMail_Title",
          "SourceString": "呗果送过奖果酱了！",
          "LocalizedString": "Bagel Has Sent Out A Praise Jam!"
        },
        "MailSubTitle": {
          "TableId": "/Game/Text/ST_Ui.ST_Ui",
          "Key": "BagelCoinMail_Title",
          "SourceString": "呗果送过奖果酱了！",
          "LocalizedString": "Bagel Has Sent Out A Praise Jam!"
        },
        "MailContent": {
          "TableId": "/Game/Text/ST_Ui.ST_Ui",
          "Key": "BagelCoinMail_Content",
          "SourceString": "亲爱的呗主们，首先感谢大家在这一段时间内对于呗果的喜爱，大家的作品呗果酱都有看到，为了感谢大家对呗果的喜爱，呗果系统将迎来更新，请注意查收呗果酱送给每一个呗主的过奖果酱哦！此外，呗果酱还有一个好消息要告诉大家，为了能让呗主们更方便地浏览自己感兴趣的内容，呗果将新增分区模块，呗主们可以自由选择感兴趣的标签进行浏览。\r\n不只是创作发帖，对优质原创内容的浏览点赞收藏都是对呗果创作生态的创建和维护，呗果酱也会更加努力，希望呗果能给大家带来更多的快乐。",
          "LocalizedString": "Dear Bagel users, first of all, thank you for all the love you've shown Bagel. Bagel-chan has seen everything you've created. To thank you for your support, the Bagel system is getting an update, so please keep an eye out for the Praise Jam Bagel-chan has sent to every user! Bagel-chan also has even more good news: to make it easier for users to find content they enjoy, Bagel is adding a new \"sections\" feature. Users will be able to browse freely by selecting the tags that interest them!\r\nCreating and posting aren't the only ways to support Bagel's creative community, though. Browsing, liking, and saving high-quality original content all help to build and sustain Bagel. No matter what, Bagel-chan will continue working hard to bring everyone even more joy through Bagel!"
        },
        "MailParams": "",
        "MailSender": {
