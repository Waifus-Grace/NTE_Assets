      "1076": {
        "MailUniqueID": "Mail_playerbirthday_1076",
        "MailType": "EHTMailType::MT_PLAYER",
        "MailSubType": "EHTMailSubType::MT_Sub_Mail_Star",
        "MailTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_Title_1076",
          "SourceString": "故事的开端",
          "LocalizedString": "故事的开端"
        },
        "MailSubTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_Title_1076",
          "SourceString": "故事的开端",
          "LocalizedString": "故事的开端"
        },
        "MailContent": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_Content_1076",
          "SourceString": "\"……我试着烤了蛋糕。\r\n薄荷原本想来帮忙，但我没让她插手——这大概是个正确的决定，她倒是也很乐意当个试吃员。烘焙比我想象中还要复杂，虽说大笨猫对那些试作品的评价很高，不过我还是有点没自信……所以我想还是再准备一样礼物好了。\r\n它算不上特别，背后也没什么逸闻趣事。也许到了明年同样的日子，可以再来看看它有没有什么特别的经历……而且到那时肯定也会有新的礼物来和它作伴吧，我猜的。\r\n——总之，生日快乐。\"",
          "LocalizedString": "\"……我试着烤了蛋糕。\r\n薄荷原本想来帮忙，但我没让她插手——这大概是个正确的决定，她倒是也很乐意当个试吃员。烘焙比我想象中还要复杂，虽说大笨猫对那些试作品的评价很高，不过我还是有点没自信……所以我想还是再准备一样礼物好了。\r\n它算不上特别，背后也没什么逸闻趣事。也许到了明年同样的日子，可以再来看看它有没有什么特别的经历……而且到那时肯定也会有新的礼物来和它作伴吧，我猜的。\r\n——总之，生日快乐。\""
        },
