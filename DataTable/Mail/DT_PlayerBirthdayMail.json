      "1072": {
        "MailUniqueID": "Mail_playerbirthday_1072",
        "MailType": "EHTMailType::MT_PLAYER",
        "MailSubType": "EHTMailSubType::MT_Sub_Mail_Star",
        "MailTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_1072_title",
          "SourceString": "哔啵~生日祝福！",
          "LocalizedString": "哔啵~生日祝福！"
        },
        "MailSubTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_1072_title",
          "SourceString": "哔啵~生日祝福！",
          "LocalizedString": "哔啵~生日祝福！"
        },
        "MailContent": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_1072_Content",
          "SourceString": "鉴定师鉴定师！生日快乐！\r\n从今天一早我就在想，该怎么给鉴定师一个超大的生日惊喜，比如做一份宇宙级生日蛋糕！或者一起去噗卡乐园玩一整天！或者让小贞戴着猫耳给你唱猫语的生日快乐歌（但她只同意了戴猫耳）！或者什——么都不做，我们一起打打游戏，看看电影，发发呆——只要开心地过就好！\r\n鉴定师今年会有什么样的愿望呢？我好想知道……对电波同频的我们来说，所有的愿望，都会变成我们共同的愿望吧！\r\n祝鉴定师生日快乐，明年、十年、一万年之后的生日！都要开开心心！",
          "LocalizedString": "鉴定师鉴定师！生日快乐！\r\n从今天一早我就在想，该怎么给鉴定师一个超大的生日惊喜，比如做一份宇宙级生日蛋糕！或者一起去噗卡乐园玩一整天！或者让小贞戴着猫耳给你唱猫语的生日快乐歌（但她只同意了戴猫耳）！或者什——么都不做，我们一起打打游戏，看看电影，发发呆——只要开心地过就好！\r\n鉴定师今年会有什么样的愿望呢？我好想知道……对电波同频的我们来说，所有的愿望，都会变成我们共同的愿望吧！\r\n祝鉴定师生日快乐，明年、十年、一万年之后的生日！都要开开心心！"
        },
        "MailParams": "",
        "MailSender": {
          "TableId": "/Game/Text/ST_Player.ST_Player",
