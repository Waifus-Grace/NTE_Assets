      "1075": {
        "MailUniqueID": "Mail_playerbirthday_1075",
        "MailType": "EHTMailType::MT_PLAYER",
        "MailSubType": "EHTMailSubType::MT_Sub_Mail_Star",
        "MailTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_Title_1075",
          "SourceString": "特别的礼物",
          "LocalizedString": "特别的礼物"
        },
        "MailSubTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_Title_1075",
          "SourceString": "特别的礼物",
          "LocalizedString": "特别的礼物"
        },
        "MailContent": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_Content_1075",
          "SourceString": ">w<鉴定师，生日快乐！！\r\n之前一直没机会问，鉴定师想要什么样的生日礼物呢？\r\n我的设想是，请鉴定师来做一场美梦~不过细想又觉得这样听起来好小气呀，我只是和平常一样使用异能而已，这又算得上什么特别的礼物呢？所以，如果鉴定师有什么别的想要的礼物，可以直接告诉我哦！「美梦一日游」也会照常给鉴定师留着的哦！\r\n或者，鉴定师有没有兴趣进到我梦里的象牙门看看呢？在生日重新体会自己从胚胎慢慢变成人的感觉……听起来很应景呢OwO",
          "LocalizedString": ">w<鉴定师，生日快乐！！\r\n之前一直没机会问，鉴定师想要什么样的生日礼物呢？\r\n我的设想是，请鉴定师来做一场美梦~不过细想又觉得这样听起来好小气呀，我只是和平常一样使用异能而已，这又算得上什么特别的礼物呢？所以，如果鉴定师有什么别的想要的礼物，可以直接告诉我哦！「美梦一日游」也会照常给鉴定师留着的哦！\r\n或者，鉴定师有没有兴趣进到我梦里的象牙门看看呢？在生日重新体会自己从胚胎慢慢变成人的感觉……听起来很应景呢OwO"
        },
