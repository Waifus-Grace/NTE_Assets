      "1090": {
        "MailUniqueID": "Mail_playerbirthday_1090",
        "MailType": "EHTMailType::MT_PLAYER",
        "MailSubType": "EHTMailSubType::MT_Sub_Mail_Star",
        "MailTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_1090_title",
          "SourceString": "世界迎来了你的美好日子~",
          "LocalizedString": "世界迎来了你的美好日子~"
        },
        "MailSubTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_1090_title",
          "SourceString": "世界迎来了你的美好日子~",
          "LocalizedString": "世界迎来了你的美好日子~"
