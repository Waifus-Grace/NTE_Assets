      "1070": {
        "MailUniqueID": "Mail_playerbirthday_1070",
        "MailType": "EHTMailType::MT_PLAYER",
        "MailSubType": "EHTMailSubType::MT_Sub_Mail_Star",
        "MailTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_Title_1070",
          "SourceString": "关于您生日相关事宜的通知",
          "LocalizedString": "关于您生日相关事宜的通知"
        },
        "MailSubTitle": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_Title_1070",
          "SourceString": "关于您生日相关事宜的通知",
          "LocalizedString": "关于您生日相关事宜的通知"
        },
        "MailContent": {
          "TableId": "/Game/Text/UI/ST_PlayerBirthdayMail.ST_PlayerBirthdayMail",
          "Key": "UI_PlayerBirthday_Content_1070",
          "SourceString": "致鉴定师：\r\n您好。\r\n兹通知您，经本委员会查证，今日确系您的生日，请您知悉。\r\n\r\n鉴于鉴定师的生日为重要节日，本委员会建议您采取以下措施，以确保本日顺利度过：\r\n一、请勿照常上班！如条件不允许，请至少提前下班，和重要的亲友共度。\r\n二、请确保今日摄入足量甜食。如您暂无准备，本委员会可提供足量甜点支援，请及时回函告知口味偏好及数量。\r\n三、请勿忘于今日结束前许下愿望。具体内容无需上报，本委员会不作干涉，但将衷心祝愿其顺利实现。\r\n\r\n如您在庆祝过程中遭遇突发状况，可随时联系本委员会工作人员，我们将立即前往解决。\r\n\r\n此致\r\n鉴定师庆生委员会（暂定）\r\n海月\r\n\r\nP.S.真的很感谢你出生在这个世界上。生日快乐！",
          "LocalizedString": "致鉴定师：\r\n您好。\r\n兹通知您，经本委员会查证，今日确系您的生日，请您知悉。\r\n\r\n鉴于鉴定师的生日为重要节日，本委员会建议您采取以下措施，以确保本日顺利度过：\r\n一、请勿照常上班！如条件不允许，请至少提前下班，和重要的亲友共度。\r\n二、请确保今日摄入足量甜食。如您暂无准备，本委员会可提供足量甜点支援，请及时回函告知口味偏好及数量。\r\n三、请勿忘于今日结束前许下愿望。具体内容无需上报，本委员会不作干涉，但将衷心祝愿其顺利实现。\r\n\r\n如您在庆祝过程中遭遇突发状况，可随时联系本委员会工作人员，我们将立即前往解决。\r\n\r\n此致\r\n鉴定师庆生委员会（暂定）\r\n海月\r\n\r\nP.S.真的很感谢你出生在这个世界上。生日快乐！"
        },
