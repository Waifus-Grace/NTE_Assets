      "MonthlyPassPurchaseException": {
        "MailType": "EHTMailType::MT_PLAYER",
        "MailSubType": "EHTMailSubType::MT_Sub_Mail_Star",
        "MailTitle": {
          "TableId": "/Game/Text/UI/ST_LyyUI.ST_LyyUI",
          "Key": "Mail_MonthCard_001",
          "SourceString": "异晶开采凭证购买异常",
          "LocalizedString": "Riftcrystal Mining Permit Purchase Error"
        },
        "MailSubTitle": {
          "TableId": "/Game/Text/UI/ST_LyyUI.ST_LyyUI",
          "Key": "Mail_MonthCard_001",
          "SourceString": "异晶开采凭证购买异常",
          "LocalizedString": "Riftcrystal Mining Permit Purchase Error"
        },
        "MailContent": {
          "TableId": "/Game/Text/UI/ST_LyyUI.ST_LyyUI",
          "Key": "Mail_MonthCard_002",
          "SourceString": "亲爱的异象猎人，因异常现象干扰，您在购买「异晶开采凭证」时，发生了重复购买现象，现已将重复支付的异晶退还至您的账户。异象猎人公会感谢您的支持，期待与您的再次合作。",
          "LocalizedString": "Dear Anomaly Hunter, due to interference from an Anomaly, a duplicate purchase occurred when you bought the Riftcrystal Mining Permit. The Riftcrystals from the duplicate payment has been refunded to your account. The Anomaly Hunter Guild thanks you for your support and looks forward to working with you again."
        },
        "MailParams": "",
        "MailSender": {
          "TableId": "/Game/Text/ST_Ui.ST_Ui",
