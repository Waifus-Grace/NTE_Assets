      "MonthlyPassExpire": {
        "MailType": "EHTMailType::MT_PLAYER",
        "MailSubType": "EHTMailSubType::MT_Sub_Mail_Star",
        "MailTitle": {
          "TableId": "/Game/Text/ST_Ui.ST_Ui",
          "Key": "MonthlyPassExpire_Title",
          "SourceString": "异晶开采凭证到期提醒",
          "LocalizedString": "Riftcrystal Mining Permit Expiration Reminder"
        },
        "MailSubTitle": {
          "TableId": "/Game/Text/ST_Ui.ST_Ui",
          "Key": "MonthlyPassExpire_Title",
          "SourceString": "异晶开采凭证到期提醒",
          "LocalizedString": "Riftcrystal Mining Permit Expiration Reminder"
        },
        "MailContent": {
          "TableId": "/Game/Text/ST_Ui.ST_Ui",
          "Key": "MonthlyPassExpire_Content",
          "SourceString": "亲爱的异象猎人，您持有的异晶开采凭证即将到期，如有需要，可前往商城续约。\r\n异象猎人公会感谢您为异晶开采工作做出的一切贡献，期待与您的再次合作。",
          "LocalizedString": "Dear Anomaly Hunter, your Riftcrystal Mining Permit is about to expire. If needed, you can renew it at the Mall.\r\nThe Anomaly Hunter Guild thanks you for all your contributions to Riftcrystal mining operations and looks forward to working with you again."
        },
        "MailParams": "",
        "MailSender": {
          "TableId": "/Game/Text/ST_Ui.ST_Ui",
          "Key": "MonthlyPassExpire_Sender",
          "SourceString": "异象猎人公会",
          "LocalizedString": "Anomaly Hunter Guild"
        },
        "MailAttachStr": "",
        "DropID": "None",
